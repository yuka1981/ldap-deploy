# OpenLDAP Initial Configuration
# This file is used for initial setup only
# Generated by Ansible

dn: cn=config
objectClass: olcGlobal
cn: config
olcArgsFile: /var/run/openldap/slapd.args
olcPidFile: /var/run/openldap/slapd.pid
olcLogLevel: 256
olcLogFile: {{ ldap_log_dir }}/slapd.log

dn: cn=module,cn=config
objectClass: olcModuleList
cn: module
olcModuleLoad: back_mdb
olcModulePath: /usr/lib64/openldap

dn: cn=schema,cn=config
objectClass: olcSchemaConfig
cn: schema

dn: cn={0}core,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: {0}core

dn: olcDatabase={1}mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: {1}mdb
olcSuffix: {{ ldap_base_dn }}
olcRootDN: {{ ldap_admin_dn }}
olcRootPW: {{ admin_password_hash }}
olcDbDirectory: /var/lib/ldap
olcDbMaxSize: 1073741824
olcDbIndex: objectClass eq,pres
olcDbIndex: ou,cn,mail,surname,givenname eq,pres,sub
olcDbIndex: uidNumber,gidNumber,memberUid eq,pres
olcDbIndex: uid,member eq,pres,sub
olcDbIndex: nisMapName,nisMapEntry eq,pres,sub

dn: olcOverlay={0}ppolicy,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: {0}ppolicy
olcPPolicyDefault: cn=default,ou=policies,{{ ldap_base_dn }}
olcPPolicyHashCleartext: TRUE
olcPPolicyUseLockout: FALSE

