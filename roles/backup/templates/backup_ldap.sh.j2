#!/bin/bash
# LDAP 備份腳本
# Generated by Ansible

set -euo pipefail

BACKUP_DIR="{{ ldap_backup_dir }}"
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_PREFIX="ldap_backup"
BACKUP_NAME="${BACKUP_PREFIX}_${DATE}"
BACKUP_PATH="${BACKUP_DIR}/${BACKUP_NAME}"

# 建立備份目錄
mkdir -p "${BACKUP_PATH}"

# 備份 LDAP 資料（slapcat）
echo "[$(date +'%Y-%m-%d %H:%M:%S')] 開始備份 LDAP 資料..."
slapcat -n 0 > "${BACKUP_PATH}/slapd_config.ldif" 2>&1 || {
    echo "錯誤: 無法備份 slapd 設定" >&2
    exit 1
}

slapcat > "${BACKUP_PATH}/ldap_data.ldif" 2>&1 || {
    echo "錯誤: 無法備份 LDAP 資料" >&2
    exit 1
}

# 備份設定檔
echo "[$(date +'%Y-%m-%d %H:%M:%S')] 備份設定檔..."
cp -a /etc/openldap "${BACKUP_PATH}/openldap_config" 2>/dev/null || true

# 備份憑證
echo "[$(date +'%Y-%m-%d %H:%M:%S')] 備份憑證..."
mkdir -p "${BACKUP_PATH}/certs"
cp -a {{ ldap_cert_dir }}/* "${BACKUP_PATH}/certs/" 2>/dev/null || true

# 壓縮備份
echo "[$(date +'%Y-%m-%d %H:%M:%S')] 壓縮備份檔案..."
tar -czf "${BACKUP_PATH}.tar.gz" -C "${BACKUP_DIR}" "${BACKUP_NAME}" || {
    echo "錯誤: 無法壓縮備份檔案" >&2
    exit 1
}

# 移除未壓縮的目錄
rm -rf "${BACKUP_PATH}"

# 計算檔案大小
BACKUP_SIZE=$(du -h "${BACKUP_PATH}.tar.gz" | cut -f1)

echo "[$(date +'%Y-%m-%d %H:%M:%S')] 備份完成: ${BACKUP_PATH}.tar.gz (${BACKUP_SIZE})"

# 如果是每月第一天，標記為月備份
if [ "$(date +%d)" = "01" ]; then
    MONTHLY_BACKUP="${BACKUP_DIR}/monthly_${BACKUP_PREFIX}_$(date +%Y%m).tar.gz"
    cp "${BACKUP_PATH}.tar.gz" "${MONTHLY_BACKUP}"
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] 已建立月備份: ${MONTHLY_BACKUP}"
fi

exit 0

