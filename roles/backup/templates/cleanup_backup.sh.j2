#!/bin/bash
# LDAP 備份清理腳本
# Generated by Ansible

set -euo pipefail

BACKUP_DIR="{{ ldap_backup_dir }}"
RETENTION_DAYS={{ ldap_backup_retention_days }}
MONTHLY_RETENTION_MONTHS={{ ldap_backup_monthly_retention_months }}

echo "[$(date +'%Y-%m-%d %H:%M:%S')] 開始清理備份檔案..."

# 刪除超過保留天數的每日備份
find "${BACKUP_DIR}" -name "ldap_backup_*.tar.gz" -type f -mtime +${RETENTION_DAYS} -delete

# 刪除超過保留月數的月備份
find "${BACKUP_DIR}" -name "monthly_ldap_backup_*.tar.gz" -type f -mtime +$((MONTHLY_RETENTION_MONTHS * 30)) -delete

# 顯示剩餘備份檔案
REMAINING_COUNT=$(find "${BACKUP_DIR}" -name "*.tar.gz" -type f | wc -l)
REMAINING_SIZE=$(du -sh "${BACKUP_DIR}" | cut -f1)

echo "[$(date +'%Y-%m-%d %H:%M:%S')] 清理完成"
echo "剩餘備份檔案數: ${REMAINING_COUNT}"
echo "備份目錄總大小: ${REMAINING_SIZE}"

exit 0

